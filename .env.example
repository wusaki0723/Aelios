# 本地开发的变量示例。
#
# 这里只是「有哪些变量」的清单，不是部署用的默认值：真正的部署默认值在
# wrangler.toml 的 [vars] 里，运行期改值走 /admin/gateway（存进 D1，优先于
# Worker 变量）。密钥不要写进 git 跟踪的文件，用 `wrangler secret put` 加。
#
# 每一行都必须对应代码里真的会读的键。加新键时把 tests/settings-coverage.test.ts
# 跑一遍：代码读的键要么在设置页上，要么是 secret，要么在 INTERNAL 里带理由。

# --- 客户端密钥（Worker Secrets）---
CHATBOX_API_KEY=sk-chatbox-xxx
IM_API_KEY=sk-im-xxx
DEBUG_API_KEY=sk-debug-xxx
MEMORY_MCP_API_KEY=sk-memory-xxx

# --- 上游 AI Gateway ---
AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>
CF_AIG_TOKEN=...

# --- 存储与向量 ---
VECTORIZE_INDEX_NAME=memo-kb
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
EMBEDDING_MODEL=google-ai-studio/gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# --- 召回 ---
MEMORY_FILTER_MAX_CANDIDATES=12
MEMORY_FILTER_MAX_OUTPUT=6
MEMORY_FILTER_MAX_CONTENT_CHARS=700
# Recall floors on the raw embedding score, applied before the reranker.
# Low on purpose — embeddinggemma under-scores reworded-but-relevant hits;
# the reranker + compressor handle precision downstream.
MEMORY_FILTER_MIN_SCORE=0.1
MEMORY_MIN_SCORE=0.1
MEMORY_TOP_K=12
# true = 丢弃没有有效 D1 记录背书的 Vectorize 命中（清理 legacy 孤儿向量），默认 false 保持现状
RECALL_REQUIRE_D1_BACKING=false

# --- 记忆库 v2 ---
# v2 默认开启；只有显式填 false 才回退旧路径。
MEMORY_LIFECYCLE_ENABLED=true
# upsert | review。默认 upsert 直接改写；填 review 改成先进候选队列等人批。
DREAM_STRATEGY=upsert

# --- 候选队列自动评审：每天夜整完用 Cloudflare 的 clef 把候选审掉，只分记住和放下，默认开 ---
# 填 off 关掉：候选全部留给人工批，或让助手用 MCP 的 memory_candidates / memory_review 自己审
CLEF_AUTO_REVIEW=on
# clef 一晚最多审几条，默认 100，也是上限
JUDGE_MAX_CANDIDATES=100
